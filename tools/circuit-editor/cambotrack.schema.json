{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stefan-cambodia.github.io/tools/circuit-editor/cambotrack.schema.json",
  "title": "cambotrack, version 1",
  "description": "Un circuit perso pour 3D Buggy et Cambodia Rally. Voir FORMAT.md pour les règles que le schéma ne sait pas exprimer (indices croissants et bornés, écarts, pentes, hash).",
  "type": "object",
  "required": ["format", "version", "id", "hash", "name", "kind", "scale", "vertical_scale", "road_width", "spacing", "surfaces", "points", "checkpoints"],
  "properties": {
    "format": { "const": "cambotrack" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "maxLength": 60 },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "games": {
      "type": "array",
      "items": { "enum": ["3d_buggy", "cambodia_rally"] },
      "uniqueItems": true,
      "maxItems": 2
    },
    "kind": { "enum": ["loop", "stage"] },
    "laps": { "type": "integer", "minimum": 1, "maximum": 20 },
    "scale": { "type": "number", "minimum": 1, "maximum": 10 },
    "vertical_scale": { "type": "number", "minimum": 0.5, "maximum": 50 },
    "road_width": { "type": "number", "minimum": 3, "maximum": 30 },
    "spacing": { "type": "number", "minimum": 1, "maximum": 20 },
    "origin": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "ele": { "type": "number", "minimum": -500, "maximum": 9000 }
      }
    },
    "length_real_m": { "type": "number", "minimum": 0 },
    "length_game_m": { "type": "number", "minimum": 0 },
    "elevation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["source", "min", "max", "climb_m"],
          "properties": {
            "source": { "type": "string", "maxLength": 80 },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "climb_m": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z_]{1,24}$" }
    },
    "points": {
      "type": "array",
      "minItems": 8,
      "maxItems": 20000,
      "items": {
        "type": "array",
        "minItems": 6,
        "prefixItems": [
          { "type": "number", "minimum": -60000, "maximum": 60000 },
          { "type": "number", "minimum": -3000, "maximum": 3000 },
          { "type": "number", "minimum": -60000, "maximum": 60000 },
          { "type": "number", "minimum": 3, "maximum": 30 },
          { "type": "integer", "minimum": 0, "maximum": 31 },
          { "type": "integer", "minimum": 0, "maximum": 255 }
        ]
      }
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "integer", "minimum": 1, "maximum": 19999 }
    },
    "gates": {
      "type": "array",
      "maxItems": 400,
      "items": { "type": "integer", "minimum": 1, "maximum": 19999 }
    },
    "waypoints": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          { "type": "number", "minimum": -90, "maximum": 90 },
          { "type": "number", "minimum": -180, "maximum": 180 }
        ]
      }
    },
    "allowed_classes": {
      "type": "array",
      "maxItems": 40,
      "items": { "type": "string", "pattern": "^[a-z_]{1,32}$" }
    },
    "attribution": { "type": "string", "maxLength": 300 },
    "scenery": {
      "type": "object",
      "required": ["v", "made", "source", "cover", "buildings", "water"],
      "properties": {
        "v": { "const": 1 },
        "made": { "type": "string" },
        "source": { "type": "string", "maxLength": 400 },
        "cover": {
          "type": "object",
          "required": ["cell", "x0", "z0", "w", "h", "rle"],
          "properties": {
            "cell": { "type": "number", "minimum": 0 },
            "x0": { "type": "number" }, "z0": { "type": "number" },
            "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 },
            "rle": { "type": "string", "pattern": "^([0-9]*[ucfgsbwma.])*$" }
          }
        },
        "buildings": {
          "type": "array", "maxItems": 8000,
          "items": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "number" } }
        },
        "water": {
          "type": "array", "maxItems": 2000,
          "items": {
            "type": "object", "required": ["kind", "ring"],
            "properties": {
              "kind": { "enum": ["pond", "lake", "river", "reservoir", "canal", "water"] },
              "ring": { "type": "array", "minItems": 3, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } }
            }
          }
        }
      }
    },
    "objects": {
      "type": "object",
      "required": ["v", "made", "items"],
      "properties": {
        "v": { "const": 1 },
        "made": { "type": "string" },
        "items": {
          "type": "array", "maxItems": 2000,
          "items": {
            "type": "array", "minItems": 5, "maxItems": 5,
            "prefixItems": [
              { "type": "string", "pattern": "^[a-z0-9_]{1,48}$" },
              { "type": "number", "minimum": -60000, "maximum": 60000 },
              { "type": "number", "minimum": -60000, "maximum": 60000 },
              { "type": "number", "minimum": 0, "maximum": 359.9 },
              { "type": "number", "minimum": 0.5, "maximum": 2 }
            ]
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["name", "lat", "lon", "point", "at_m", "side", "offset_m", "x", "z", "w", "h", "image"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "spot": { "type": "integer", "minimum": 1, "maximum": 24 },
          "view": { "enum": ["front", "left", "right", "extra"] },
          "lat": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon": { "type": "number", "minimum": -180, "maximum": 180 },
          "ele": { "type": "number", "minimum": -10000, "maximum": 10000 },
          "taken": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$" },
          "bearing": { "type": "number", "minimum": 0, "maximum": 360 },
          "point": { "type": "integer", "minimum": 0, "maximum": 19999 },
          "at_m": { "type": "number", "minimum": 0 },
          "side": { "enum": ["left", "right"] },
          "offset_m": { "type": "number", "minimum": 0 },
          "x": { "type": "number", "minimum": -60000, "maximum": 60000 },
          "z": { "type": "number", "minimum": -60000, "maximum": 60000 },
          "w": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "h": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "image": { "type": "string", "maxLength": 400000, "pattern": "^data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}$" }
        }
      }
    }
  }
}
